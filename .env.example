# GEMINI_API_KEY: Required for Gemini AI API calls on the backend server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used by the backend server to sign auth tokens and Firestore teacher approval signatures.
SESSION_SECRET="replace-with-a-strong-random-server-secret"

# ============================================================================
# KHỞI TẠO QUẢN TRỊ VIÊN ĐẦU TIÊN PHÍA MÁY CHỦ (FIREBASE ADMIN SDK)
# ============================================================================
# BẢO MẬT TUYỆT ĐỐI:
# - KHÔNG đặt tiền tố VITE_ cho các biến dưới đây.
# - KHÔNG đưa khóa dịch vụ Firebase Admin vào mã trình duyệt hoặc commit lên Git.
#
# 1. FIRST_ADMIN_UID: UID của tài khoản Firebase Authentication đầu tiên được cấp quyền Quản trị viên.
#    Lấy tại: Firebase Console -> Authentication -> Users (cột User UID) hoặc xem trong hộp thoại
#    "Đăng nhập" của ứng dụng sau khi đăng nhập bằng Google/Firebase.
FIRST_ADMIN_UID=""

# 2. Khóa dịch vụ Firebase Admin SDK (chọn 1 trong 2 cách bên dưới):
#    Cách A (Khuyên dùng trên Cloud/Container): Dán toàn bộ nội dung tệp JSON của Service Account
#    trên 1 dòng vào biến FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=""

#    Cách B (Máy chủ cục bộ): Đặt đường dẫn tuyệt đối hoặc tương đối tới tệp JSON của Service Account
#    (đã được chặn trong .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=""

# ============================================================================
# CẤU HÌNH DỊCH VỤ GỬI MÃ XÁC MINH GMAIL OTP CHO GIÁO VIÊN (CHỌN 1 TRONG 2)
# ============================================================================
# Lựa chọn 1: Dùng dịch vụ Resend API (Khuyên dùng)
RESEND_API_KEY=""
OTP_EMAIL_FROM="VanAI 12 <no-reply@yourdomain.com>"

# Lựa chọn 2: Dùng máy chủ SMTP / Gmail App Password (nếu không dùng Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
