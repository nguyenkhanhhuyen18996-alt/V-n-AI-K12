{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/bootstrap-status",
      "destination": "/api/auth/bootstrap-status"
    },
    {
      "source": "/api/auth/google-match",
      "destination": "/api/auth/google-match"
    },
    {
      "source": "/api/auth/bootstrap-admin",
      "destination": "/api/auth/bootstrap-admin"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
